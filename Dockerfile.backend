# Build stage
FROM node:16-alpine AS builder
WORKDIR /app/apiserver
COPY apiserver/package*.json ./
RUN npm ci --only=production && npm cache clean --force

# Runtime stage
FROM node:16-alpine
WORKDIR /app/apiserver
RUN apk add --no-cache dumb-init
COPY --from=builder /app/apiserver/node_modules ./node_modules
COPY apiserver .
EXPOSE 8010
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8010/api/v1/auth/check-auth', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "index.js"]
